<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Site Name</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #121212;
            color: #fff;
        }

        header {
            background: #1f1f1f;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav a {
            color: #fff;
            margin: 0 10px;
            text-decoration: none;
        }

        nav a:hover {
            color: #00bcd4;
        }

        .hero {
            text-align: center;
            padding: 60px 20px;
            background: linear-gradient(to right, #00bcd4, #2196f3);
        }

        .hero h1 {
            margin-bottom: 10px;
        }

        .section {
            padding: 40px 20px;
            text-align: center;
        }

        .cards {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .card {
            background: #1e1e1e;
            padding: 20px;
            border-radius: 10px;
            width: 250px;
        }

        .card h3 {
            margin-top: 0;
        }

        form {
            max-width: 400px;
            margin: auto;
            display: flex;
            flex-direction: column;
        }

        input, textarea, button {
            margin: 10px 0;
            padding: 10px;
            border: none;
            border-radius: 5px;
        }

        button {
            background: #00bcd4;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background: #0097a7;
        }

        footer {
            background: #1f1f1f;
            text-align: center;
            padding: 15px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

<header>
    <h2>Your Brand</h2>
    <nav>
        <a href="#">Home</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section class="hero">
    <h1>Welcome to Your Site</h1>
    <p>Simple, clean, and ready to build on</p>
</section>

<section id="services" class="section">
    <h2>What We Offer</h2>
    <div class="cards">
        <div class="card">
            <h3>Service 1</h3>
            <p>Description here</p>
        </div>
        <div class="card">
            <h3>Service 2</h3>
            <p>Description here</p>
        </div>
        <div class="card">
            <h3>Service 3</h3>
            <p>Description here</p>
        </div>
    </div>
</section>

<section id="contact" class="section">
    <h2>Contact / Order</h2>
    <form>
        <input type="text" placeholder="Name" required>
        <input type="email" placeholder="Email" required>
        <textarea placeholder="Message or Order"></textarea>
        <button type="submit">Submit</button>
    </form>
</section>

<footer>
    <p>© 2026 Your Name</p>
</footer>

</body>
</html>
